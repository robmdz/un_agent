# Railway Environment Variables Template
# Copy these to your Railway project's environment variables

# LiveKit Configuration (REQUIRED)
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here

# Google Maps API (REQUIRED for location features)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Search API (REQUIRED for search features)
SERPAPI_API_KEY=your_serpapi_key_here

# Python Memory Optimization (OPTIONAL - Railway sets these automatically)
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Port (Railway sets this automatically)
PORT=8080
